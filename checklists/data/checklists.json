    {
      "id": "AUTH-001",
      "title": "Successful login",
      "category": "authentication",
      "description": "A user can authenticate using valid credentials.",
      "priority": "critical",
      "version": 1,
      "preconditions": [
        "A test account exists",
        "Valid test credentials are available"
      ],
      "steps": [
        "Reach the login interface",
        "Enter valid credentials",
        "Submit the login form",
        "Reach an authenticated area"
      ],
      "goal_conditions": [
        "The user is authenticated",
        "The authenticated area is accessible"
      ],
      "tags": ["login", "authentication", "positive"]
    },
    {
      "id": "AUTH-002",
      "title": "Reject invalid login",
      "category": "authentication",
      "description": "Invalid credentials must not authenticate a user.",
      "priority": "critical",
      "version": 1,
      "preconditions": [
        "The login interface is accessible",
        "Invalid test credentials are available"
      ],
      "steps": [
        "Reach the login interface",
        "Enter invalid credentials",
        "Submit the login form"
      ],
      "goal_conditions": [
        "Authentication is rejected",
        "The user remains unauthenticated"
      ],
      "tags": ["login", "authentication", "negative"]
    },
    {
      "id": "AUTH-003",
      "title": "Logout",
      "category": "authentication",
      "description": "An authenticated user can end their session.",
      "priority": "high",
      "version": 1,
      "preconditions": [
        "A test user is authenticated"
      ],
      "steps": [
        "Reach an authenticated area",
        "Trigger the logout action"
      ],
      "goal_conditions": [
        "The session is ended",
        "Protected content is no longer accessible"
      ],
      "tags": ["logout", "authentication", "session"]
    },
    {
      "id": "AUTH-004",
      "title": "Password recovery",
      "category": "authentication",
      "description": "A user can initiate password recovery.",
      "priority": "high",
      "version": 1,
      "preconditions": [
        "Password recovery is available",
        "A controlled test account exists"
      ],
      "steps": [
        "Reach the password recovery interface",
