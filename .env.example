# Copy to .env and fill in. Real environment variables always win over this file.
# .env is gitignored — never commit a key.

# Which provider the semantic mapper uses: anthropic | openai
BLINDSPOT_LLM_PROVIDER=openai

# Model id for that provider. Omit to use the provider's default
# (anthropic: claude-opus-5, openai: gpt-5).
BLINDSPOT_LLM_MODEL=gpt-5

# Credentials — only the one for your chosen provider is needed.
OPENAI_API_KEY=sk-proj
# ANTHROPIC_API_KEY=sk-ant-...
